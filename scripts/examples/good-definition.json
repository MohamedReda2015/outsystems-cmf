          "mechanism": "activityAction"
        },
        {
          "from": "UnderReview",
          "to": "PendingApproval",
          "trigger": {
            "activity": "ReviewRequest",
            "action": "Recommend"
          },
          "mechanism": "activityAction"
        },
        {
          "from": "UnderReview",
          "to": "Rejected",

          },
          "mechanism": "activityAction"
        },
        {
          "from": "PendingInfo",
          "to": "Cancelled",
          "trigger": {
            "system": "SlaExpired"
          },
          "mechanism": "statusUpdate"
        },
        {
          "from": "PendingApproval",
          "to": "Approved",
          "trigger": {
            "activity": "ApproveRequest",
            "action": "Approve"
          },
          "mechanism": "activityAction"
        },
        {
          "from": "PendingApproval",
          "to": "Rejected",
          "trigger": {
            "activity": "ApproveRequest",
            "action": "Reject"
          },
          "mechanism": "activityAction"
        },
        {
          "from": "Draft",
          "to": "Cancelled",
          "trigger": {
            "system": "DraftExpired"
          },
          "mechanism": "statusUpdate"
        }
